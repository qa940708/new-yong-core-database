{
  "schemaVersion": 1,
  "version": "play-guide-images-20261002",
  "guides": [
    {
      "id": "index",
      "n": 1,
      "name": "初入校園",
      "lead": "領取新生裝備與補給，準備開始練等。",
      "note": "部分新手裝備有期限，使用前請查看道具說明。",
      "chapters": [
        {
          "name": "查看新生禮盒",
          "hint": "在背包找到新生禮盒，查看內含的裝備與道具。",
          "image": "assets/guide-media/play-index-step-01-gift-20261002.png",
          "width": 1029,
          "height": 800
        },
        {
          "name": "領取新生補給",
          "hint": "使用新生禮盒，領取裝備與補給，並留意道具期限。",
          "image": "assets/guide-media/play-index-step-02-open-20261002.png",
          "width": 1025,
          "height": 799
        },
        {
          "name": "穿戴裝備",
          "hint": "穿上武器與防具，將恢復道具放到快捷列。",
          "image": "assets/guide-media/play-index-step-03-equip-20261002.png",
          "width": 1027,
          "height": 798
        },
        {
          "name": "開始練等",
          "hint": "前往附近的怪物區，手動攻擊並累積經驗。",
          "image": "assets/guide-media/play-index-step-04-battle-20261002.png",
          "width": 1028,
          "height": 800
        }
      ]
    },
    {
      "id": "travel",
      "n": 2,
      "name": "操作、移動與地圖",
      "lead": "設定熱鍵、搭乘公車，利用地圖尋找怪物與掉落物。",
      "note": "",
      "chapters": [
        {
          "name": "開啟快捷鍵設定",
          "hint": "開啟遊戲選單，點選「快捷鍵設置」。",
          "image": "assets/guide-media/play-travel-step-01-menu-20261002.png",
          "width": 1024,
          "height": 791
        },
        {
          "name": "選擇操作模式",
          "hint": "選擇「鍵盤操作模式 A／B」，調整按鍵後按「應用」或「確定」。",
          "image": "assets/guide-media/play-travel-step-02-keys-20261002.png",
          "width": 459,
          "height": 525
        },
        {
          "name": "搭乘公車",
          "hint": "與學院服務員對話，選「公車站」，再挑選目的地並按「OK」。",
          "image": "assets/guide-media/play-travel-step-03-bus-20261002.png",
          "width": 1023,
          "height": 798
        },
        {
          "name": "查詢怪物與掉落",
          "hint": "按 M 開啟地圖並切到「資訊」，勾選怪物查看分布與掉落物。",
          "image": "assets/guide-media/play-travel-step-04-map-20261002.png",
          "width": 1026,
          "height": 797
        }
      ]
    },
    {
      "id": "collection",
      "n": 3,
      "name": "收藏使用方式",
      "lead": "收集並登錄指定核心，完成收藏取得能力加成。",
      "note": "指定核心不能用同類別的其他核心替代。",
      "chapters": [
        {
          "name": "開啟個人收藏",
          "hint": "點擊畫面下方快捷列的「個人收藏」圖示。",
          "image": "assets/guide-media/collection-step-01-open-20261002.png",
          "width": 469,
          "height": 468
        },
        {
          "name": "核對收藏需求",
          "hint": "選擇收藏組合與核心，查看所需數量、成功率及完成加成。",
          "image": "assets/guide-media/collection-step-02-requirements-20261002.png",
          "width": 710,
          "height": 508
        },
        {
          "name": "選取核心並註冊",
          "hint": "點選右側的對應核心，再按右下角「註冊」。",
          "image": "assets/guide-media/collection-step-03-register-20261002.png",
          "width": 708,
          "height": 508
        },
        {
          "name": "查看收藏成果",
          "hint": "組合完成後會顯示 COMPLETED；點「效果」查看總加成與整體進度。",
          "image": "assets/guide-media/collection-step-04-results-20261002.png",
          "width": 708,
          "height": 506
        }
      ]
    },
    {
      "id": "core",
      "n": 4,
      "name": "裝備核心",
      "lead": "為裝備開孔、鑲嵌核心，搭配需要的能力。",
      "note": "開孔器可能失敗並消耗，但不會損壞裝備或清除原有孔位；移除器使用後會消耗。",
      "chapters": [
        {
          "name": "確認核心槽",
          "hint": "查看裝備說明中的「核心槽」，確認目前孔位與上限。",
          "image": "assets/guide-media/play-core-step-01-slots-20261002.png",
          "width": 1027,
          "height": 798
        },
        {
          "name": "開啟核心孔位",
          "hint": "點選核心打洞器，再對裝備按右鍵；每次成功開一孔，最多三孔。",
          "image": "assets/guide-media/play-core-step-02-drill-20261002.png",
          "width": 1026,
          "height": 797
        },
        {
          "name": "挑選核心",
          "hint": "查看核心的類別與能力，挑選需要的加成。",
          "image": "assets/guide-media/play-core-step-03-select-20261002.png",
          "width": 1026,
          "height": 797
        },
        {
          "name": "鑲嵌並確認加成",
          "hint": "將核心鑲嵌到已開啟的孔位；每孔一顆，同件裝備不能重複相同類別。",
          "image": "assets/guide-media/play-core-step-04-insert-20261002.png",
          "width": 1026,
          "height": 798
        },
        {
          "name": "使用核心移除器",
          "hint": "點選核心移除器，再對裝備按右鍵，一次取下全部核心。",
          "image": "assets/guide-media/play-core-step-05-remove-20261002.png",
          "width": 1025,
          "height": 795
        },
        {
          "name": "確認核心返回背包",
          "hint": "查看核心是否已回到背包，裝備開啟的孔位會保留。",
          "image": "assets/guide-media/play-core-step-06-return-20261002.png",
          "width": 1027,
          "height": 801
        }
      ]
    },
    {
      "id": "enhancement",
      "n": 5,
      "name": "裝備強化",
      "lead": "武器使用磨石，防具使用護貝劑。",
      "note": "防爆不保證成功；觸發保護時會消耗材料與一條項鍊，並將強化等級歸零。",
      "chapters": [
        {
          "name": "確認強化材料",
          "hint": "武器使用磨石，防具使用護貝劑；一般材料可強化至 +4。",
          "image": "assets/guide-media/play-enhancement-step-01-material-20261002.png",
          "width": 1028,
          "height": 798
        },
        {
          "name": "強化並查看加值",
          "hint": "對裝備使用適用的強化材料，查看成功訊息與裝備加值。",
          "image": "assets/guide-media/play-enhancement-step-02-success-20261002.png",
          "width": 1027,
          "height": 798
        },
        {
          "name": "穿戴防爆項鍊",
          "hint": "進階強化前，可先穿戴防爆項鍊，防止觸發裝備消失的結果。",
          "image": "assets/guide-media/play-enhancement-step-03-protect-20261002.png",
          "width": 1022,
          "height": 798
        },
        {
          "name": "確認進階強化結果",
          "hint": "進階強化也可能失敗；查看系統訊息與裝備加值，確認是否降級或歸零。",
          "image": "assets/guide-media/play-enhancement-step-04-result-20261002.png",
          "width": 1026,
          "height": 796
        }
      ]
    },
    {
      "id": "remodel",
      "n": 6,
      "name": "隨機改造卡",
      "lead": "重新隨機裝備屬性，可搭配鎖定卡保留指定項目。",
      "note": "改造會消耗卡片；使用鎖定卡也會消耗。未鎖定的屬性不保證變得更好。",
      "chapters": [
        {
          "name": "使用隨機改造卡",
          "hint": "使用隨機屬性改造卡，開啟道具改造視窗。",
          "image": "assets/guide-media/play-remodel-step-01-open-20261002.png",
          "width": 1024,
          "height": 799
        },
        {
          "name": "放入裝備",
          "hint": "放入要改造的裝備，勾選「維持原有屬性」，以便比較新舊結果。",
          "image": "assets/guide-media/play-remodel-step-02-equipment-20261002.png",
          "width": 1028,
          "height": 800
        },
        {
          "name": "執行改造",
          "hint": "點「執行改造」，確認後按「是」。",
          "image": "assets/guide-media/play-remodel-step-03-confirm-20261002.png",
          "width": 1025,
          "height": 801
        },
        {
          "name": "比較並選取結果",
          "hint": "比較左右兩側屬性；要採用新結果時，點「選取結果數值」。",
          "image": "assets/guide-media/play-remodel-step-04-compare-20261002.png",
          "width": 1027,
          "height": 798
        },
        {
          "name": "單項鎖定",
          "hint": "放入單項鎖定卡，勾選 1 項要保留的屬性，再執行改造。",
          "image": "assets/guide-media/play-remodel-step-05-lock-one-20261002.png",
          "width": 1026,
          "height": 797
        },
        {
          "name": "雙重鎖定",
          "hint": "放入雙重鎖定卡，可勾選 2 項屬性；未鎖定的項目會重新隨機。",
          "image": "assets/guide-media/play-remodel-step-06-lock-two-20261002.png",
          "width": 608,
          "height": 630
        },
        {
          "name": "三重鎖定",
          "hint": "放入三重鎖定卡，可勾選 3 項屬性，保留後再改造其他項目。",
          "image": "assets/guide-media/play-remodel-step-07-lock-three-20261002.png",
          "width": 1025,
          "height": 798
        },
        {
          "name": "按住 Ctrl 查看數值範圍",
          "hint": "在改造視窗按住 Ctrl，即可查看各項屬性的數值範圍。",
          "image": "assets/guide-media/play-remodel-step-08-ctrl-range-20261002.png",
          "width": 1025,
          "height": 796
        }
      ]
    }
  ],
